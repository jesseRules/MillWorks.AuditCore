{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MillWorks.AuditCore": "Debug"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "",
    "AzureStorage": ""
  },
  "KeyVault": {
    "Url": "https://your-keyvault.vault.azure.net/"
  },
  "Encryption": {
    "UseFileStorage": false,
    "KeyStorePath": "/secure/encryption-keys",
    "MasterKey": ""
  },
  "Audit": {
    "Enabled": true,
    "ApplicationName": "SampleApp",
    "Environment": "Development",
    "HmacKey": "FAKE-HMAC-KEY-1234567890",
    "EnableDigitalSignatures": false,
    "RetentionDays": 365,
    "EntityFramework": {
      "ConnectionString": "",
      "MigrateOnStartup": false,
      "Schema": "audit",
      "CommandTimeoutSeconds": 30,
      "MigrationTimeoutSeconds": 300
    },
    "Security": {
      "EnableTamperDetection": true,
      "UseRedisLocking": false
    },
    "Resilience": {
      "EnableDeadLetterQueue": true,
      "DeadLetterProvider": "FileSystem",
      "EnableBackgroundProcessor": true,
      "MaxRetries": 3,
      "RetryDelaySeconds": 1
    },
    "Archival": {
      "Provider": "AzureBlob",
      "ConnectionString": "",
      "RetentionDays": 365,
      "EnableBackgroundArchival": true,
      "ArchivalIntervalHours": 24
    }
  }
}
