<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>MillWorks.AuditCore</PackageId>
    <Description>Tamper-evident audit logging and compliance platform for .NET — batteries-included package with EF Core and ASP.NET Core integration</Description>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MillWorks.AuditCore.Abstractions\MillWorks.AuditCore.Abstractions.csproj"/>
    <ProjectReference Include="..\MillWorks.AuditCore.Services\MillWorks.AuditCore.Services.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!--
      File-system signing-key backend for audit integrity keys (Cryptography consolidation A1).
      The DI composition (MillWorksAuditBuilder.UseSecurity) wires FileSigningKeyProvider as the
      default integrity-key backend; hosts can override with KeyVault by registering their own
      ISigningKeyProvider. Brings MillWorks.Cryptography + .Abstractions transitively.
    -->
    <PackageReference Include="MillWorks.Cryptography.FileSystem" Version="0.2.0" />
    <!--
      Key Vault encryption-key backend for field-level encryption (Cryptography consolidation A2).
      EncryptionConfigurationExtensions.UseFieldEncryption(keyVaultUrl) constructs an
      AzureKeyVaultEncryptionKeyProvider directly; the SecretClient / DefaultAzureCredential refs
      back that construction. The file-system backend (above) covers UseFieldEncryptionWithFileStorage.
    -->
    <PackageReference Include="MillWorks.Cryptography.KeyVault" Version="0.2.0" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

</Project>
