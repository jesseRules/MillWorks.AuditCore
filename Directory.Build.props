<Project>
    <PropertyGroup>
        <!-- Version - Change this ONE place to update all projects -->
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>

        <!-- Package Metadata -->
        <Authors>Jesse Carlberg</Authors>
        <Company>MillWorks</Company>
        <Product>MillWorks AuditCore</Product>
        <Description>Tamper-evident audit logging and compliance platform for .NET</Description>
        <Copyright>Copyright © 2025 MillWorks</Copyright>

        <!-- Package Settings -->
        <PackageProjectUrl>https://github.com/jesserules/millworks.auditcore</PackageProjectUrl>
        <RepositoryUrl>https://github.com/jesserules/millworks.auditcore</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageTags>audit;logging;compliance;security;tamper-detection;efcore;aspnetcore</PackageTags>
        <PackageReleaseNotes>Initial public release</PackageReleaseNotes>

        <!-- Symbols & Source Link -->
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- Build Settings -->
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

        <!-- Ensure project references become package dependencies when packing -->
        <IncludeReferencedProjects>true</IncludeReferencedProjects>

        <!-- Deterministic builds for CI -->
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup Condition="'$(CI)' == 'true'">
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    </ItemGroup>
</Project>
