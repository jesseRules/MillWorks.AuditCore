<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.14.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
        <PackageReference Include="Moq" Version="4.20.72" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
        <!--
          Pin the native SQLite binary above the transitive 2.1.11 pulled in by EF Core's
          Sqlite provider. GHSA-2m69-gcr7-jv3q flags SQLitePCLRaw.lib.e_sqlite3 <= 2.1.11
          (the bundled SQLite C library). 3.50.3 is the patched build (its version tracks the
          SQLite version, 3.50.3). The package carries no managed dependencies, so it swaps in
          under the 2.1.11 core/provider/bundle stack over the stable SQLite C ABI.
        -->
        <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.11" />
        <!--
          Pin System.Security.Cryptography.Xml above the transitive 10.0.5 pulled in by
          DataProtection. GHSA-37gx-xxp4-5rgx / GHSA-w3x6-4m5h-cxqf cover <= 10.0.5 only.
        -->
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
        <PackageReference Include="FluentAssertions" Version="8.10.0" />
        <PackageReference Include="Polly" Version="8.7.0" />
        <PackageReference Include="Testcontainers.MsSql" Version="4.13.0" />
        <!-- Override the vulnerable transitive version; fixes GHSA-q939-rpr3-3284. -->
        <PackageReference Include="SSH.NET" Version="2026.0.0" />
        <PackageReference Include="Respawn" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
        <Using Include="Moq" />
        <Using Include="System" />
        <Using Include="System.Collections.Generic" />
        <Using Include="System.Linq" />
        <Using Include="System.Threading" />
        <Using Include="System.Threading.Tasks" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\MillWorks.AuditCore.Abstractions\MillWorks.AuditCore.Abstractions.csproj" />
        <ProjectReference Include="..\..\src\MillWorks.AuditCore.AspNetCore\MillWorks.AuditCore.AspNetCore.csproj" />
        <ProjectReference Include="..\..\src\MillWorks.AuditCore.EntityFramework\MillWorks.AuditCore.EntityFramework.csproj" />
        <ProjectReference Include="..\..\src\MillWorks.AuditCore.Providers\MillWorks.AuditCore.Providers.csproj" />
        <ProjectReference Include="..\..\src\MillWorks.AuditCore.Services\MillWorks.AuditCore.Services.csproj" />
    </ItemGroup>

</Project>
